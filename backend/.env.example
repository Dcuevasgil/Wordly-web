# ==============================
# APLICACIÓN
# Identidad, entorno y comportamiento general del framework
# ==============================

APP_NAME=Wordly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Madrid


# ==============================
# IDIOMA
# Locale de los mensajes del framework y de los datos generados por Faker
# ==============================

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US


# ==============================
# MANTENIMIENTO Y SERVIDOR LOCAL
# ==============================

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4


# ==============================
# SEGURIDAD
# Coste de hasheo de contraseñas (2^12 iteraciones de bcrypt)
# ==============================

BCRYPT_ROUNDS=12


# ==============================
# LOGS
# Destino y nivel de detalle del registro de la aplicación
# ==============================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# ==============================
# BASE DE DATOS
# Conexión a MySQL
# ==============================

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wordly
DB_USERNAME=
DB_PASSWORD=


# ==============================
# SESIONES
# Apenas se usan: la autenticación de la API va por JWT
# ==============================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ==============================
# COLAS, ALMACENAMIENTO Y BROADCASTING
# ==============================

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database


# ==============================
# CACHÉ
# Redis y Memcached vienen por defecto; el proyecto no los usa
# ==============================

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379


# ==============================
# CORREO
# En local no se envía nada: los emails se escriben en el log
# ==============================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


# ==============================
# AWS
# Sin uso en el proyecto
# ==============================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# ==============================
# FRONTEND
# Las variables VITE_ se compilan en el JS y son públicas: nunca meter secretos
# ==============================

VITE_APP_NAME="${APP_NAME}"


# ==============================
# AUTENTICACIÓN JWT
# Generar con: php artisan jwt:secret
# ==============================

JWT_SECRET=


# ==============================
# OLLAMA
# Servicio local de IA para el chatbot conversacional
# ==============================

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120